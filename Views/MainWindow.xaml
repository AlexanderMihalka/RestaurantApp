<Window x:Class="RestaurantApp.Views.MainWindow"
        xmlns:loc="clr-namespace:RestaurantApp.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RestaurantApp.ViewModels"
        xmlns:conv="clr-namespace:RestaurantApp.Converters"
        Title="🍽️ Restaurant Manager" Height="750" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}">

    <Window.Resources>
        <conv:StatusToColorConverter   x:Key="StatusColor"/>
        <conv:StatusToStringConverter  x:Key="StatusString"/>
        <conv:CurrencyConverter        x:Key="Currency"/>
        <conv:BoolToAvailableConverter x:Key="BoolAvail"/>

        <!-- Кнопки перемикача мови: активна мова підсвічується -->
        <Style x:Key="LangButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding"    Value="10,4"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="LangButtonUk" TargetType="Button" BasedOn="{StaticResource LangButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Language, Source={x:Static loc:Loc.Instance}}" Value="uk">
                    <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground"  Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LangButtonEn" TargetType="Button" BasedOn="{StaticResource LangButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Language, Source={x:Static loc:Loc.Instance}}" Value="en">
                    <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground"  Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍽️" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Restaurant Manager" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextLightBrush}"/>
                        <TextBlock Text="{loc:Tr Header_Subtitle}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText"
                               FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Перемикач мови інтерфейсу -->
                    <Button Content="UK" Margin="20,0,0,0"
                            Style="{StaticResource LangButtonUk}"
                            Command="{Binding SetLanguageCommand}" CommandParameter="uk"/>
                    <Button Content="EN"
                            Style="{StaticResource LangButtonEn}"
                            Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ STATS BAR ═══ -->
        <Border Grid.Row="1" Background="{StaticResource SecondaryBrush}"
                BorderBrush="#1A2F50" BorderThickness="0,1,0,1" Padding="24,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                    <TextBlock Text="🔥" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveOrdersCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{loc:Tr Stat_ActiveOrders}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                    <TextBlock Text="📋" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding TotalDishesCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="#4CAF50"/>
                        <TextBlock Text="{loc:Tr Stat_Dishes}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                    <TextBlock Text="👥" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding WaitersCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="#2196F3"/>
                        <TextBlock Text="{loc:Tr Stat_Waiters}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💰" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding TodayRevenue, Converter={StaticResource Currency}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#FFA500"/>
                        <TextBlock Text="{loc:Tr Stat_Revenue}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ TAB CONTENT ═══ -->
        <TabControl Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex}">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="20,12"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Padding="{TemplateBinding Padding}"
                                        Background="Transparent">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush"
                                                Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Вкладка Замовлення -->
            <TabItem Header="{loc:Tr Tab_Orders}">
                <ContentControl Content="{Binding OrderVM}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Frame Source="/Views/OrderView.xaml" NavigationUIVisibility="Hidden"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </TabItem>

            <!-- Вкладка Меню -->
            <TabItem Header="{loc:Tr Tab_Menu}">
                <ContentControl Content="{Binding MenuVM}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Frame Source="/Views/MenuView.xaml" NavigationUIVisibility="Hidden"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </TabItem>

            <!-- Вкладка Офіціанти -->
            <TabItem Header="{loc:Tr Tab_Waiters}">
                <ContentControl Content="{Binding WaiterVM}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Frame Source="/Views/WaiterView.xaml" NavigationUIVisibility="Hidden"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
