<Page x:Class="RestaurantApp.Views.WaiterView"
      xmlns:loc="clr-namespace:RestaurantApp.Localization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:RestaurantApp.Converters"
      Background="{StaticResource PrimaryBrush}">

    <Page.Resources>
        <conv:StatusToColorConverter  x:Key="StatusColor"/>
        <conv:StatusToStringConverter x:Key="StatusString"/>
        <conv:CurrencyConverter       x:Key="Currency"/>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════
             СПИСОК ОФІЦІАНТІВ
             ══════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Tr Waiters_Title}" Style="{StaticResource SectionHeader}"/>

                <ListBox Grid.Row="1" Style="{StaticResource ModernListBox}"
                         ItemContainerStyle="{StaticResource ModernListBoxItem}"
                         ItemsSource="{Binding Waiters}"
                         SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0A1F3A" CornerRadius="10" Padding="14" Margin="0,0,0,8"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="#12305A"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44"
                                            CornerRadius="22" Background="#1A4A6E"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Emoji}" FontSize="22"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                   Foreground="{StaticResource TextLightBrush}" FontSize="14"/>
                                        <TextBlock Text="{Binding Phone}" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{loc:Fmt Key=Waiters_ActiveCount, Path=ActiveOrders.Count}"
                                                   FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:F0} ₴'}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════
             ЗАМОВЛЕННЯ ОФІЦІАНТА
             ══════════════════════════════════ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Tr Waiters_Orders}" Style="{StaticResource SectionHeader}"/>

                <!-- Статистика обраного -->
                <Border Grid.Row="1" Background="#0A1F3A" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CompletedCount}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Waiters_Completed}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:F0} ₴'}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Waiters_Revenue}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Список замовлень офіціанта -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0A1F3A" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Fmt Key=Order_Number, Path=Id}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextLightBrush}"/>
                                            <TextBlock Text="{loc:Fmt Key=Table_Number, Path=TableNumber}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='🕐 {0:HH:mm}'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,0,4"
                                                    Background="{Binding Status, Converter={StaticResource StatusColor}}">
                                                <TextBlock Text="{loc:Status}"
                                                           FontSize="11" Foreground="White"/>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}">
                                                <!-- Відображаємо суму через ToString -->
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════
             ФОРМА НОВОГО ОФІЦІАНТА
             ══════════════════════════════════ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Tr Waiters_NewTitle}" Style="{StaticResource SectionHeader}"/>

                <!-- Вибір аватара -->
                <TextBlock Text="{loc:Tr Waiters_Avatar}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding EmojiOptions}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" FontSize="22"
                                    Width="40" Height="40" Margin="2"
                                    Command="{Binding DataContext.SetEmojiCommand,
                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#0A1F3A"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1A3F6A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Поточний вибір -->
                <Border Background="#0A1F3A" CornerRadius="8" Padding="8" Margin="0,0,0,16"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Emoji}" FontSize="36" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="{loc:Tr Waiters_Name}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Text="{loc:Tr Waiters_Phone}" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,20"/>

                <Button Content="{loc:Tr Waiters_Add}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddWaiterCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                <Button Content="{loc:Tr Waiters_Remove}"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding RemoveWaiterCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                <Button Content="{loc:Tr Waiters_Clear}"
                        Style="{StaticResource SecondaryButton}"
                        Foreground="{StaticResource TextLightBrush}"
                        Command="{Binding ClearCommand}"
                        HorizontalAlignment="Stretch"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource SuccessBrush}"
                           FontSize="12" Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
