<Page x:Class="RestaurantApp.Views.MenuView"
      xmlns:loc="clr-namespace:RestaurantApp.Localization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:RestaurantApp.Converters"
      Background="{StaticResource PrimaryBrush}">

    <Page.Resources>
        <conv:CurrencyConverter       x:Key="Currency"/>
        <conv:BoolToAvailableConverter x:Key="BoolAvail"/>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════
             ЛІВО: Список страв меню
             ══════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Tr Menu_Title}" Style="{StaticResource SectionHeader}"/>

                <!-- Пошук + фільтр -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"/>
                </Grid>

                <!-- Картки страв -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Dishes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" Margin="0,0,8,8" CornerRadius="10"
                                        Padding="14" Cursor="Hand"
                                        Background="#0F3460">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <EventTrigger RoutedEvent="Border.MouseEnter">
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Emoji}" FontSize="36"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                   Foreground="{StaticResource TextLightBrush}"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Category}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:F2} ₴'}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <Border CornerRadius="4" Padding="4,2" Margin="0,6,0,0"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Background" Value="#1B4332"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Background" Value="#4A1010"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{loc:Avail}"
                                                       FontSize="11" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════
             ПРАВО: Форма додавання страви
             ══════════════════════════════════ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Tr Menu_AddTitle}" Style="{StaticResource SectionHeader}"/>

                <!-- Вибір емодзі -->
                <TextBlock Text="{loc:Tr Menu_Emoji}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding NewEmoji, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="22" TextAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="{loc:Tr Menu_Name}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Text="{loc:Tr Menu_Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                <TextBlock Text="{loc:Tr Menu_Price}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding NewPriceText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Text="{loc:Tr Menu_Category}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox Style="{StaticResource ModernComboBox}"
                          Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          ItemsSource="{Binding Categories}"
                          Margin="0,0,0,20"/>

                <Button Content="{loc:Tr Menu_AddButton}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddDishCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                <Button Content="{loc:Tr Menu_RemoveButton}"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding RemoveDishCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"/>

                <Button Content="{loc:Tr Menu_ClearButton}"
                        Style="{StaticResource SecondaryButton}"
                        Foreground="{StaticResource TextLightBrush}"
                        Command="{Binding ClearFormCommand}"
                        HorizontalAlignment="Stretch"/>

                <Border Background="#0A1F3A" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{loc:Tr Menu_Hint}"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
